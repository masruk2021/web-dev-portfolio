<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>OCMS</display-name>

    <!-- Welcome file -->
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <!-- Servlet mappings -->
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>com.ocms.servlets.auth.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>com.ocms.servlets.auth.LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

    <!-- Admin -->
    <servlet>
        <servlet-name>AddCourseServlet</servlet-name>
        <servlet-class>com.ocms.servlets.admin.AddCourseServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AddCourseServlet</servlet-name>
        <url-pattern>/admin/add-course</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AssignTeacherServlet</servlet-name>
        <servlet-class>com.ocms.servlets.admin.AssignTeacherServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AssignTeacherServlet</servlet-name>
        <url-pattern>/admin/assign-teacher</url-pattern>
    </servlet-mapping>

    <!-- Student -->
    <servlet>
        <servlet-name>RegisterCourseServlet</servlet-name>
        <servlet-class>com.ocms.servlets.student.RegisterCourseServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RegisterCourseServlet</servlet-name>
        <url-pattern>/student/register-course</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>MyCoursesServlet</servlet-name>
        <servlet-class>com.ocms.servlets.student.MyCoursesServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>MyCoursesServlet</servlet-name>
        <url-pattern>/student/my-courses</url-pattern>
    </servlet-mapping>

    <!-- Teacher -->
    <servlet>
        <servlet-name>AssignedCoursesServlet</servlet-name>
        <servlet-class>com.ocms.servlets.teacher.AssignedCoursesServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AssignedCoursesServlet</servlet-name>
        <url-pattern>/teacher/assigned-courses</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>CourseStudentsServlet</servlet-name>
        <servlet-class>com.ocms.servlets.teacher.CourseStudentsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CourseStudentsServlet</servlet-name>
        <url-pattern>/teacher/course-students</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>SeedServlet</servlet-name>
        <servlet-class>com.ocms.servlets.SeedServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SeedServlet</servlet-name>
        <url-pattern>/seed</url-pattern>
    </servlet-mapping>

    <!-- Filters -->
    <filter>
        <filter-name>AuthFilter</filter-name>
        <filter-class>com.ocms.filters.AuthFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- Context params -->
    <context-param>
        <param-name>MONGODB_URI</param-name>
        <param-value>mongodb://localhost:27017</param-value>
    </context-param>
    <context-param>
        <param-name>MONGODB_DB</param-name>
        <param-value>ocms</param-value>
    </context-param>

</web-app>

